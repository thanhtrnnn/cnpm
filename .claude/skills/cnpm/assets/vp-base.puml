' VP Base Theme v2 — matches Visual Paradigm default styling
' Font: Dialog (Java Swing default on ALL platforms)
' Sequence: #7AD2FF blue, transparent actor
' UC: #7ACFF5 blue fill
' Class: white boxes, no package colors, no stereotypes

skinparam linetype ortho
skinparam defaultFontName "Dialog"
skinparam defaultFontSize 10
skinparam shadowing false
skinparam arrowColor #000000
skinparam lineColor #000000
hide circle

skinparam usecase {
  BackgroundColor #7ACFF5
  BorderColor Black
  FontColor Black
}

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor Black
}

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
  FontSize 10
  AttributeFontSize 9
  AttributeIconSize 0
  BorderThickness 1
}

skinparam sequence {
  ArrowColor Black
  ArrowThickness 1
  ArrowFontSize 10
  MessageFontSize 10
  MessageAlign left
  ActorBorderColor Black
  ActorBackgroundColor transparent
  ParticipantBorderColor Black
  ParticipantBackgroundColor #7AD2FF
  ParticipantFontSize 10
  LifeLineBorderColor Black
  LifeLineBackgroundColor #7AD2FF
  LifeLineThickness 1
  BoundaryBorderColor Black
  BoundaryBackgroundColor #7AD2FF
  ControlBorderColor Black
  ControlBackgroundColor #7AD2FF
  EntityBorderColor Black
  EntityBackgroundColor #7AD2FF
  DividerFontSize 9
  GroupFontSize 9
  GroupingBorderColor Black
  GroupingBackgroundColor #7AD2FF
  ReferenceBorderColor Black
  ReferenceBackgroundColor #7AD2FF
}

hide empty members
